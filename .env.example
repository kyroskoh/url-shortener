# Blink / layurl.com — copy to .env and adjust

# Public base URL used in short-link display (no trailing slash)
BLINK_BASE_URL=http://localhost
BLINK_SITE_TITLE=Blink

# Admin auth (plain values hashed at startup if not already argon2 hashes)
BLINK_PASSWORD=changeme
BLINK_API_KEY=changeme-api-key

# Set to true to allow unauthenticated link creation (list/delete still need admin)
BLINK_PUBLIC_MODE=false

# Set to true to serve API only (nginx can still proxy redirects)
BLINK_DISABLE_FRONTEND=false

# Comma-separated extra URL protocols beyond http,https,ftp,magnet
BLINK_EXTRA_PROTOCOLS=

# Slug generation
BLINK_SLUG_LENGTH=8

# Redis rate limit: max requests per window per client IP
BLINK_RATE_LIMIT_MAX=120
BLINK_RATE_LIMIT_WINDOW_SEC=60

# Redirect cache TTL in Redis (seconds)
BLINK_CACHE_TTL_SEC=300

# Destination preview cache TTL in Redis (seconds)
BLINK_PREVIEW_TTL_SEC=3600

# Optional custom HTML for `/` (overrides redirect to /admin/). Mount the file in the api container.
# Example: BLINK_LANDING_PAGE=/data/landing.html
BLINK_LANDING_PAGE=

# Session cookie
BLINK_SESSION_SECRET=replace-with-long-random-string

# Cloudflare Turnstile (optional; public create skips when unset unless FORCE)
BLINK_TURNSTILE_SITE_KEY=
BLINK_TURNSTILE_SECRET_KEY=
# When true, public create always requires Turnstile (fail closed if keys missing)
BLINK_TURNSTILE_FORCE=false

# URL safety check on create/edit: none | blocklist | http
BLINK_URL_CHECK_PROVIDER=none
BLINK_URL_CHECK_BLOCKLIST_PATH=
# HTTP provider: POST JSON { url, host } → { ok: true } or { allowed: true }
BLINK_URL_CHECK_HTTP_URL=

# Database / Redis (compose defaults)
DATABASE_URL=postgres://blink:blink@postgres:5432/blink
REDIS_URL=redis://redis:6379

# Cloudflare provisioner (deploy/scripts/cloudflare-provision.mjs)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_IPV4=
CLOUDFLARE_ORIGIN_IPV6=
# Set true to also upsert www CNAME/A
CLOUDFLARE_MANAGE_WWW=true
