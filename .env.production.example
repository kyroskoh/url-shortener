# Copy to .env.production (gitignored) and fill real values:
#
#   cp .env.production.example .env.production
#   # fill secrets; prefer DEPLOY_SSH_KEY_FILE=/path/to/key
#
#   gh auth login   # once, if needed
#   npm run ops:ship   # or: npm run ops:cf-dry-run first
#
# ops:ship syncs secrets to GitHub Environment "production", applies Cloudflare, deploys Compose.

# --- App (required) ---
BLINK_BASE_URL=https://layurl.com
BLINK_PASSWORD=
BLINK_API_KEY=
BLINK_SESSION_SECRET=
POSTGRES_PASSWORD=
BLINK_PUBLIC_MODE=false
BLINK_TURNSTILE_FORCE=false
BLINK_TURNSTILE_SITE_KEY=
BLINK_TURNSTILE_SECRET_KEY=

# --- Cloudflare provisioner (required for apply) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ORIGIN_IPV4=
CLOUDFLARE_ORIGIN_IPV6=
CLOUDFLARE_MANAGE_WWW=true

# --- SSH deploy (required for ship) ---
DEPLOY_HOST=
DEPLOY_USER=
# Paste PEM as a single line with \n escapes, OR set path:
# DEPLOY_SSH_KEY_FILE=/path/to/id_ed25519
DEPLOY_SSH_KEY=
DEPLOY_SSH_KEY_FILE=
# Optional path on origin (default ~/url-shortener)
DEPLOY_PATH=~/url-shortener
# Optional: PAT if host cannot pull GHCR with GITHUB_TOKEN
GHCR_PULL_TOKEN=

# --- Ship defaults ---
# Image tag to deploy (v0.6.1, latest, …)
BLINK_IMAGE_TAG=latest
HEALTHCHECK_URL=
GITHUB_REPO=kyroskoh/url-shortener
